# Base URL of your school's Moodle site (used for setup navigation and session checks)
MOODLE_URL=https://moodle.example.edu

# Persistent Chromium profile directory (cookies, localStorage, session state)
MOODLE_BROWSER_PROFILE=./browser-profile

# Directory where downloaded Moodle files are saved
MOODLE_DOWNLOAD_DIR=./downloads

# Run browser headless when MCP server is active (setup always uses headed mode)
MOODLE_BROWSER_HEADLESS=true

# Default Playwright timeout in milliseconds
MOODLE_BROWSER_TIMEOUT=30000

# Max visible text characters returned by browser_read
MOODLE_MAX_TEXT_LENGTH=8000

# Comma-separated URL path fragments that indicate a Moodle login page
MOODLE_LOGIN_URL_PATTERNS=/login/index.php,/login/

# Enable debug logging (never logs passwords, cookies, or tokens)
MOODLE_MCP_DEBUG=false

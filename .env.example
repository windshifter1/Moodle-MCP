# Your school's Moodle website URL (no password goes here)
MOODLE_URL=https://moodle.example.edu

# Local Playwright browser profile used to keep you logged in
MOODLE_BROWSER_PROFILE=./browser-profile

# HTTP MCP server bind address (localhost only by default)
MCP_HOST=127.0.0.1
MCP_PORT=3000

# Optional: where downloaded Moodle files are saved
MOODLE_DOWNLOAD_DIR=./downloads

# Optional: run Chromium headless while the MCP server is running
MOODLE_BROWSER_HEADLESS=true

# Optional: enable safe debug logging (never logs passwords, cookies, or tokens)
MOODLE_MCP_DEBUG=false
